Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Grid1/Offset1
        - /Scan Filtered1/Autocompute Value Bounds1
        - /Contains Test Model1/Namespaces1
      Splitter Ratio: 0.4968017041683197
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
  - Class: rviz_common/Views
    Name: Views
  - Class: rviz_common/Time
    Name: Time
Visualization Manager:
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Offset:
        Z: -0.07
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Collision Enabled: true
      Description Topic:
        Value: /robot_description
      Enabled: false
      Name: RobotModel
      Value: false
      Visual Enabled: false
    - Class: rviz_default_plugins/TF
      Marker Scale: 0.15
      Name: TF
      Show Names: true
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Color: 204; 0; 0
      Color Transformer: FlatColor
      Name: Scan Raw
      Position Transformer: XYZ
      Topic:
        Reliability Policy: Best Effort
        Value: /scan
      Value: true
      Class: rviz_default_plugins/LaserScan
      Color: 73; 168; 53
      Color Transformer: AxisColor
      Decay Time: 6
      Max Intensity: 715
      Name: Scan Filtered
      Position Transformer: XYZ
      Size (m): 0.029999999329447746
      Style: Points
      Topic:
        Filter size: 10
        Value: /scan_filtered
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Color: 193; 125; 17
      Color Transformer: FlatColor
      Decay Time: 6
      Max Intensity: 524
      Min Intensity: 247
      Name: Scan INSIDE
      Position Transformer: XYZ
      Size (Pixels): 6
      Size (m): 0.029999999329447746
      Style: Points
      Topic:
        Value: /scan_point_cloud_inside
      Value: true
    - Alpha: 0.800000011920929
      Class: rviz_default_plugins/PointCloud2
      Color: 32; 74; 135
      Color Transformer: FlatColor
      Decay Time: 6
      Max Intensity: -999999
      Min Intensity: 999999
      Name: Scan CLIP
      Position Transformer: XYZ
      Size (m): 0.10000000149011612
      Topic:
        Value: /scan_point_cloud_clip
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Color: 92; 53; 102
      Color Transformer: FlatColor
      Decay Time: 6
      Max Intensity: 634
      Min Intensity: 336
      Name: Scan SHADOW
      Position Transformer: XYZ
      Size (Pixels): 10
      Size (m): 0.3499999940395355
      Style: Points
      Topic:
        Value: /scan_point_cloud_shadow
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: false
      Name: Contains Test Model
      Value: false
    - Class: rviz_default_plugins/MarkerArray
      Enabled: false
      Name: Shadow Test Model
      Value: false
    - Class: rviz_default_plugins/Marker
      Enabled: false
      Name: Bounding box
      Topic:
        Filter size: 10
      Value: false
    - Class: rviz_default_plugins/MarkerArray
      Enabled: false
      Name: Bounding box debug
      Value: false
    - Class: rviz_default_plugins/Marker
      Enabled: false
      Name: Local Bounding Box
      Topic:
        Filter size: 10
      Value: false
    - Class: rviz_default_plugins/MarkerArray
      Enabled: false
      Name: LocalBounding Box Debug
      Value: false
    - Class: rviz_default_plugins/Marker
      Enabled: false
      Name: Bounding sphere
      Topic:
        Filter size: 10
      Value: false
    - Class: rviz_default_plugins/MarkerArray
      Enabled: false
      Name: Bounding sphere debug
      Value: false
    - Class: rviz_default_plugins/PointCloud2
      Color Transformer: Intensity
      Max Intensity: 654
      Min Intensity: 240
      Name: No bbox scan
      Position Transformer: XYZ
      Topic:
        Value: /scan_point_cloud_no_bbox
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Color Transformer: Intensity
      Enabled: false
      Max Intensity: 656
      Min Intensity: 226
      Name: No local bbox scan
      Position Transformer: XYZ
      Topic:
        Value: /scan_point_cloud_no_local_bbox
      Value: false
  Enabled: true
  Global Options:
    Fixed Frame: base_link
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /move_base_simple/goal
    - Class: rviz_default_plugins/PublishPoint
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 5.639042854309082
      Focal Point:
        X: 0.1392146199941635
        Y: 0.04977293685078621
        Z: 0.4855469763278961
      Focal Shape Fixed Size: false
      Name: Current View
      Pitch: 0.5147969126701355
      Target Frame: base_link
      Yaw: 6.237194061279297
    Saved:
      - Class: rviz_default_plugins/Orbit
        Distance: 1
        Focal Point:
          X: 1
          Z: -0.07000000029802322
        Name: Front
        Pitch: 0
        Yaw: 0
      - Class: rviz_default_plugins/Orbit
        Distance: 1
        Focal Point:
          Y: 1
          Z: -0.07000000029802322
        Name: Left
        Pitch: 0
        Yaw: 1.5399999618530273
      - Class: rviz_default_plugins/Orbit
        Distance: 1
        Focal Point:
          Y: -1
          Z: -0.07000000029802322
        Name: Right
        Pitch: 0
        Yaw: -1.5399999618530273
      - Class: rviz_default_plugins/Orbit
        Distance: 3
        Name: Top
        Pitch: 1.5399999618530273
        Yaw: 3.140000104904175
Window Geometry:
  Height: 1013
